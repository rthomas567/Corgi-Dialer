# --- Server ---
PORT=4000

# A shared password the frontend must send on every request (simple gate,
# not per-rep auth). Set this to something random.
DIALER_SHARED_SECRET=change-me

# --- SignalWire ---
# Your Space subdomain, e.g. corgi.signalwire.com
SIGNALWIRE_SPACE=your-space.signalwire.com
# Dashboard -> API -> Project ID
SIGNALWIRE_PROJECT_ID=00000000-0000-0000-0000-000000000000
# Dashboard -> API -> API Token (this is the "API Token", not a Subscriber password)
SIGNALWIRE_API_TOKEN=PTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Twenty CRM ---
# Your workspace's REST API base URL
TWENTY_API_URL=https://corgi-smb.twenty.com/rest
# Settings -> API & Webhooks -> API keys -> create one, paste it here
TWENTY_API_KEY=your_twenty_api_key_here
